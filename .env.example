# Copie para .env e ajuste. Os valores abaixo batem com o docker-compose.yml.

# Banco (Prisma)
DATABASE_URL="postgresql://reformai:reformai@localhost:5432/reformai"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave"
AUTH_URL="http://localhost:3000"

# Arquivos (S3-compatível: MinIO local, S3/R2 em produção)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="reformai"
S3_ACCESS_KEY_ID="reformai"
S3_SECRET_ACCESS_KEY="reformai123"
S3_FORCE_PATH_STYLE="true"

# Julia-1 (decisões) — ver docs/julia-1-api.md. Sem JULIA_URL, o app funciona só com as regras.
# Servidor self-hosted do wrapper REST (docker compose --profile julia up → http://localhost:8000).
# JULIA_URL="http://localhost:8000"
# JULIA_TIMEOUT_MS="3000"
# JULIA_MIN_CONFIDENCE="0.6"   # abaixo disso a resposta é registrada, mas não aplicada

# Claude (apoio, opcional — Fase 7). Sem chave, os botões de IA não aparecem.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
