    "db:seed": "bunx --bun prisma db seed",
    "db:studio": "bunx --bun prisma studio",
    "postinstall": "prisma generate",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
